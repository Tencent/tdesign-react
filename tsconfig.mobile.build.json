{
  "extends": "./tsconfig",
  "include": ["packages/mobile-components", "./globals.d.ts"],
  "exclude": [
    "**/**/__tests__/*",
    "**/**/_example-js/*",
    "**/**/_example/*",
    "**/**/_usage/*",
    "node_modules",
    "dist",
    "lib",
