{
  "extends": "./tsconfig",
  "include": ["packages/pro-components/chat", "./globals.d.ts"],
  "exclude": [
    "**/**/__tests__/*",
    "**/**/_example/*",
    "**/**/_example-js/*",
    "**/**/_usage/*",
    "es",
    "node_modules"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "rootDir": "packages/pro-components/chat",
    "skipLibCheck": true,
    "paths": {
      "@tdesign/ai-chat-engine": ["./packages/tdesign-react-aigc/node_modules/@tdesign/ai-chat-engine"],
      "tdesign-react": ["./packages/tdesign-react-aigc/node_modules/tdesign-react"],
      "tdesign-react/*": ["./packages/tdesign-react-aigc/node_modules/tdesign-react/*"]
    }
  }
}
